+ * tagged SetMetadata call (tu_dw_send_times, set by the Darwin backend). Kinds: */
+enum tu_dw_kind {
+   TU_DW_PASS_GMEM, TU_DW_PASS_SYSMEM, TU_DW_BLIT, TU_DW_COPY, TU_DW_RESOLVE, TU_DW_CLEAR, TU_DW_KINDS
+};
