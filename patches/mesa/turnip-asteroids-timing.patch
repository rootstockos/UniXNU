diff --git a/src/freedreno/vulkan/tu_cmd_buffer.h b/src/freedreno/vulkan/tu_cmd_buffer.h
index 6078c3d..57ed0d3 100644
--- a/src/freedreno/vulkan/tu_cmd_buffer.h
+++ b/src/freedreno/vulkan/tu_cmd_buffer.h
@@ -664,10 +664,32 @@ struct tu_dw_stats {
 };
 extern struct tu_dw_stats tu_dw_pending;
 
+/* asteroids: GPU time per kind of work. Each render pass, blit, copy, resolve and image clear is bracketed by two GPU timestamps
+ * (always-on counter, RB_DONE_TS) in the command buffer's sub_cs; when the command buffer is reset or freed (Vulkan allows it only
+ * once the GPU is done with it) the brackets are added up per kind, and about once a second the totals go to the kernel through a
+ * tagged SetMetadata call (tu_dw_send_times, set by the Darwin backend). Kinds: */
+enum tu_dw_kind {
+   TU_DW_PASS_GMEM, TU_DW_PASS_SYSMEM, TU_DW_BLIT, TU_DW_COPY, TU_DW_RESOLVE, TU_DW_CLEAR, TU_DW_KINDS
+};
+#define TU_DW_MAX_SLOTS 96
+struct tu_dw_slot {
+   uint32_t *map;   /* start lo, start hi, end lo, end hi, written by the GPU */
+   uint64_t iova;
+   uint8_t kind;
+};
+extern void (*tu_dw_send_times)(const uint32_t *words, unsigned count);
+struct tu_cmd_buffer;
+struct tu_cs;
+unsigned tu_dw_time_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned kind);
+void tu_dw_time_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned slot);
+void tu_dw_time_collect(struct tu_cmd_buffer *cmd);
+
 struct tu_cmd_buffer
 {
    struct vk_command_buffer vk;
    struct tu_dw_stats dw_stats;
+   struct tu_dw_slot dw_slots[TU_DW_MAX_SLOTS];
+   unsigned dw_slot_count;
 
    struct tu_device *device;
 
diff --git a/src/freedreno/vulkan/tu_knl_darwin.cc b/src/freedreno/vulkan/tu_knl_darwin.cc
index ad687d0..917fb98 100644
--- a/src/freedreno/vulkan/tu_knl_darwin.cc
+++ b/src/freedreno/vulkan/tu_knl_darwin.cc
@@ -88,6 +88,19 @@ dw_call(uint32_t method, const void *in, size_t in_size, void *out,
                                     out_size ? &out_bytes : NULL);
 }
 
+/* asteroids: GPU time per kind of work (tu_dw_time_collect) to the kernel, which adds it to its totals: a SetMetadata call with no
+ * object and the tag 'TIME' in the reserved word (asteroids NativeAdreno), the words as the text. */
+static void
+darwin_send_times(const uint32_t *words, unsigned count)
+{
+   NativeAdrenoAbiMetadata req = {};
+   req.handle = 0;
+   req.reserved = 0x54494d45u;
+   req.bytes = MIN2(count * 4u, (unsigned) NativeAdrenoAbiMetadataBytes);
+   memcpy(req.text, words, req.bytes);
+   (void) dw_call(NativeAdrenoMethodSetMetadata, &req, sizeof(req), NULL, 0);
+}
