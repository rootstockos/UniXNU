+/* asteroids: GPU time per kind of work. Each render pass, blit, copy, resolve and image clear is bracketed by two GPU timestamps
+ * (always-on counter, RB_DONE_TS) in the command buffer's sub_cs; when the command buffer is reset or freed (Vulkan allows it only
+ * once the GPU is done with it) the brackets are added up per kind, and about once a second the totals go to the kernel through a
+ * tagged SetMetadata call (tu_dw_send_times, set by the Darwin backend). Kinds: */
+enum tu_dw_kind {
+   TU_DW_PASS_GMEM, TU_DW_PASS_SYSMEM, TU_DW_BLIT, TU_DW_COPY, TU_DW_RESOLVE, TU_DW_CLEAR, TU_DW_KINDS
+};
+#define TU_DW_MAX_SLOTS 96
+struct tu_dw_slot {
+   uint32_t *map;   /* start lo, start hi, end lo, end hi, written by the GPU */
+   uint64_t iova;
+   uint8_t kind;
+   /* TU_DW_TIME=tiles, GMEM passes: the pass's stage record (tu_dw_rp_*), its tiles, tile size in pixels, HW binning, attachments
+    * loaded and stored, subpasses, render area in pixels */
+   uint64_t *rp_map;
+   uint32_t tiles, tile_px, area_px;
+   uint8_t binning, loads, stores, subpasses;
+};
+/* TU_DW_TIME=tiles: a GMEM pass's stage record, 64-bit always-on stamps written by the GPU: */
+enum tu_dw_rp {
+   TU_DW_RP_TILE,      /* a tile's start, before its draw IB */
+   TU_DW_RP_LOADS,     /* after the first subpass's loads and clears (in draw_cs, GMEM only) */
+   TU_DW_RP_DRAWS,     /* after the draw IB */
+   TU_DW_RP_STORES,    /* after the tile's stores */
+   TU_DW_RP_BEGIN,     /* after tu6_tile_render_begin (binning included) */
+   TU_DW_RP_SUM_LOADS, /* sums over the tiles, added by the GPU (CP_MEM_TO_MEM) */
+   TU_DW_RP_SUM_DRAWS,
+   TU_DW_RP_SUM_STORES,
+   TU_DW_RP_WORDS
+};
+extern void (*tu_dw_send_times)(uint32_t tag, const uint32_t *words, unsigned count);
+struct tu_cmd_buffer;
+struct tu_cs;
+unsigned tu_dw_time_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned kind);
+void tu_dw_time_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned slot);
+void tu_dw_time_collect(struct tu_cmd_buffer *cmd);
+void tu_dw_rp_loads(struct tu_cmd_buffer *cmd);
+void tu_dw_rp_stamp(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned which);
+void tu_dw_rp_tile_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs);
+void tu_dw_frag_entry(uint64_t area_px, uint32_t draws, uint64_t samples, bool has_samples, bool sysmem);
