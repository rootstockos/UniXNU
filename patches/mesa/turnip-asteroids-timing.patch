@@ -88,6 +88,19 @@ dw_call(uint32_t method, const void *in, size_t in_size, void *out,
                                     out_size ? &out_bytes : NULL);
 }
 
+/* asteroids: GPU time per kind of work (tu_dw_time_collect) to the kernel, which adds it to its totals: a SetMetadata call with no
+ * object and the tag 'TIME' in the reserved word (asteroids NativeAdreno), the words as the text. */
+static void
+darwin_send_times(uint32_t tag, const uint32_t *words, unsigned count)
+{
+   NativeAdrenoAbiMetadata req = {};
+   req.handle = 0;
+   req.reserved = tag;
+   req.bytes = MIN2(count * 4u, (unsigned) NativeAdrenoAbiMetadataBytes);
+   memcpy(req.text, words, req.bytes);
+   (void) dw_call(NativeAdrenoMethodSetMetadata, &req, sizeof(req), NULL, 0);
+}
