+static uint64_t tu_dw_ticks[TU_DW_KINDS], tu_dw_last_send_ns;
+static uint32_t tu_dw_counts[TU_DW_KINDS], tu_dw_buffers, tu_dw_unrun, tu_dw_dropped;
+/* TU_DW_TIME=tiles, GMEM pass stages: ticks for begin (binning included), loads, draws, stores, end and between tiles; then counts */
+static uint64_t tu_dw_stage_ticks[6];
+static uint32_t tu_dw_stage_passes, tu_dw_stage_tiles, tu_dw_stage_binning, tu_dw_stage_rejected, tu_dw_stage_max_tiles,
+   tu_dw_stage_loads, tu_dw_stage_stores, tu_dw_stage_multi;
+static uint64_t tu_dw_stage_tile_px, tu_dw_stage_area_px;
+/* T60: by pass size (large: a render area of 1 MP or more), from the timing brackets: passes, ticks, render area; from the
+ * autotune's finished entries: entries, draws, samples passed, render area, entries rendered in system memory */
+#define TU_DW_LARGE_PX (1u << 20)
+static uint64_t tu_dw_size_ticks[2], tu_dw_size_area[2], tu_dw_frag_samples[2], tu_dw_frag_area[2];
+static uint32_t tu_dw_size_passes[2], tu_dw_frag_n[2], tu_dw_frag_draws[2], tu_dw_frag_sysmem[2], tu_dw_frag_nosamples,
+   tu_dw_frag_max_draws;
+
+static bool tu_dw_alloc(struct tu_cmd_buffer *cmd, uint32_t dwords, struct tu_cs_memory *memory);
+
+/* TU_DW_TRACE=<letters>: p passes, d draws, s each draw's samples passed (GPU counters around every draw), b shader binaries, t GMEM
+ * passes by stage, a blits, copies, resolves and clears too; "1" is pdb. */
+enum {
+   TU_DW_TR_PASSES = 1, TU_DW_TR_DRAWS = 2, TU_DW_TR_SAMPLES = 4, TU_DW_TR_BINARIES = 8, TU_DW_TR_STAGES = 16, TU_DW_TR_ALL = 32,
+};
+static int
+tu_dw_trace_flags(void)
+{
+   static int flags = -1;
+   if (flags < 0) {
+      const char *v = getenv("TU_DW_TRACE");
+      flags = 0;
+      if (v && !strcmp(v, "1"))
+         flags = TU_DW_TR_PASSES | TU_DW_TR_DRAWS | TU_DW_TR_BINARIES;
+      for (; v && *v; v++)
+         flags |= *v == 'p' ? TU_DW_TR_PASSES : *v == 'd' ? TU_DW_TR_DRAWS : *v == 's' ? TU_DW_TR_SAMPLES | TU_DW_TR_DRAWS :
+                  *v == 'b' ? TU_DW_TR_BINARIES : *v == 't' ? TU_DW_TR_STAGES : *v == 'a' ? TU_DW_TR_ALL : 0;
+      if (flags)
+         flags |= TU_DW_TR_PASSES;   /* draws and stages are joined to their pass */
+   }
+   return flags;
+}
+
+/* TU_DW_TIME: absent 0 (off), "passes" 1, "tiles" 3 (passes, and GMEM passes by stage), anything else 2 (all kinds). Without it,
+ * TU_DW_TRACE picks the mode from its letters. */
+static int
+tu_dw_mode(void)
+{
+   static int mode = -1;
+   if (mode < 0) {
+      const char *v = getenv("TU_DW_TIME");
+      const int trace = tu_dw_trace_flags();
+      mode = v ? (!strcmp(v, "passes") ? 1 : !strcmp(v, "tiles") ? 3 : 2) :
+             !trace ? 0 : (trace & TU_DW_TR_STAGES) ? 3 : (trace & TU_DW_TR_ALL) ? 2 : 1;
+   }
+   return mode;
+}
+
+/* The trace file. Every record starts with u16 type, u16 0, u32 bytes (the whole record); little endian, packed. The file starts with
+ * "TUDWTRC1", u32 the always-on counter's frequency, u32 pid, u64 the CPU's monotonic clock in ns at open. scripts/gpu-trace.py in
+ * UniXNU-asteroids reads it; a change here goes with a change there. */
+enum { TU_DW_REC_PASS = 1, TU_DW_REC_DRAW = 3, TU_DW_REC_SHADER = 4, TU_DW_REC_FRAG = 5, TU_DW_REC_NOTE = 6 };
+struct PACKED tu_dw_rec_head { uint16_t type, zero; uint32_t bytes; };
+/* A timed pass, blit, copy, resolve or clear (kind: tu_dw_kind), at its command buffer's reset. Stage stamps are 0 unless flags & 2. */
+struct PACKED tu_dw_trace_pass {
+   struct tu_dw_rec_head head;
+   uint32_t serial;
+   uint16_t pass_no;
+   uint8_t kind, flags;   /* flags: 1 HW binning, 2 stage stamps, 4 system memory chosen by coverage (TU_DW_LIGHT) */
+   uint64_t start, end;
+   uint32_t area_px;
+   uint16_t width, height, tiles, tile_w, tile_h;
+   uint8_t loads, stores, subpasses, attachments;
+   uint32_t draws;
+   uint64_t st_begin, st_last, sum_loads, sum_draws, sum_stores;
+   struct PACKED { uint32_t format; uint8_t samples, flags, pad[2]; } att[4];   /* flags: 1 load, 2 store, 4 clear, 8 UBWC, 16 tiled */
+};
+/* A draw as recorded; samples is the GPU's count of samples passed (TU_DW_TRACE s), else ~0. */
+struct PACKED tu_dw_trace_draw {
+   struct tu_dw_rec_head head;
+   uint32_t serial;
+   uint16_t pass_no, draw_no;
+   uint64_t vs_id, fs_id;   /* the first 8 bytes of the stages' BLAKE3, as the shader records */
+   uint32_t count;          /* vertices or indices, 0 for indirect */
+   uint8_t flags;           /* 1 indexed, 2 indirect */
+   uint8_t att_count, blend_mask, write_mask, write_enables;
+   uint8_t src_color, dst_color, color_op, src_alpha, dst_alpha, alpha_op;
+   uint8_t ds;              /* 1 depth test, 2 depth write, 4 stencil test, 8 depth bounds */
+   uint8_t samples_per_px;  /* rasterization samples */
+   uint8_t pad[3];
+   uint16_t scissor[4];     /* x, y, width, height */
+   uint64_t samples;
+};
+struct tu_dw_draw_pending {
+   struct tu_dw_trace_draw rec;
+   const volatile uint64_t *samples;   /* begin, result, end: the GPU adds each tile's samples into result */
+};
+/* A shader the trace saw for the first time, with ir3's statistics, then its binary (TU_DW_TRACE b) of bin_bytes. */
+struct PACKED tu_dw_trace_shader {
+   struct tu_dw_rec_head head;
+   uint64_t id;
+   uint8_t stage, double_threadsize, subgroup_size, early_preamble;
+   int8_t max_reg, max_half_reg, max_waves, pad;
+   uint32_t constlen, size;
+   uint16_t sizedwords, instrs_count, preamble_instrs_count, nops_count, mov_count, cov_count, loops, stp_count, ldp_count, ss, sy,
+      sstall, systall, last_baryf, last_helper, pad2;
+   uint16_t instrs_per_cat[8];
+   uint32_t bin_bytes;
+};
+/* An autotune entry once the GPU has finished it: draws and samples passed for the whole pass. */
+struct PACKED tu_dw_trace_frag {
+   struct tu_dw_rec_head head;
+   uint32_t serial;
+   uint16_t pass_no;
+   uint8_t sysmem, has_samples;
+   uint32_t draws, area_px;
+   uint64_t samples;
+};
+
+static simple_mtx_t tu_dw_trace_mtx = SIMPLE_MTX_INITIALIZER;
+static uint8_t *tu_dw_tbuf;
+static size_t tu_dw_tlen;
+static int tu_dw_tfd = -2;   /* -2 not tried, -1 no file */
+static uint64_t tu_dw_twritten, tu_dw_tflushed_ns;
+static uint32_t tu_dw_tlost, tu_dw_next_serial;
+#define TU_DW_TBUF (1u << 20)
+#define TU_DW_TCAP (56ull << 20)   /* the export takes 64 MiB at most (BootLog.c, sheng-gpu-trace-export) */
+
+static void
+tu_dw_trace_flush(void)
+{
+   if (tu_dw_tfd >= 0 && tu_dw_tlen) {
+      if (write(tu_dw_tfd, tu_dw_tbuf, tu_dw_tlen) == (ssize_t) tu_dw_tlen)
+         tu_dw_twritten += tu_dw_tlen;
+      else
+         tu_dw_tlost++;
+   }
+   tu_dw_tlen = 0;
+}
+
+/* Under tu_dw_trace_mtx. The file opens on the first record: the render server's cache directory, as the Metal frontend's frames.trace. */
+static void
+tu_dw_trace_put(const void *rec, size_t bytes, const void *tail = NULL, size_t tail_bytes = 0)
+{
+   if (tu_dw_tfd == -2) {
+      tu_dw_tfd = -1;
+      static const char *const dirs[] = {"/private/var/mobile/Library/Caches/com.apple.backboardd/m2v/gpu",
+                                         "/private/var/root/Library/Caches/com.apple.backboardd/m2v/gpu"};
+      const char *path = getenv("TU_DW_TRACE_PATH");
+      char buf[160];
+      for (unsigned i = 0; !path && i < ARRAY_SIZE(dirs); i++) {
+         mkdir(dirs[i], 0755);
+         snprintf(buf, sizeof(buf), "%s/trace.bin", dirs[i]);
+         const int fd = open(buf, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+         if (fd >= 0)
+            tu_dw_tfd = fd;
+         if (fd >= 0)
+            break;
+      }
+      if (path)
+         tu_dw_tfd = open(path, O_WRONLY | O_CREAT | O_TRUNC | O_CLOEXEC, 0644);
+      tu_dw_tbuf = tu_dw_tfd >= 0 ? (uint8_t *) malloc(TU_DW_TBUF) : NULL;
+      if (!tu_dw_tbuf && tu_dw_tfd >= 0) {
+         close(tu_dw_tfd);
+         tu_dw_tfd = -1;
+      }
+      if (tu_dw_tfd >= 0) {
+         struct PACKED { char magic[8]; uint32_t freq, pid; uint64_t ns; } h = {{'T', 'U', 'D', 'W', 'T', 'R', 'C', '1'}, 19200000,
+                                                                                 (uint32_t) getpid(), os_time_get_nano()};
+         memcpy(tu_dw_tbuf, &h, sizeof(h));
+         tu_dw_tlen = sizeof(h);
+      }
+   }
+   if (tu_dw_tfd < 0)
+      return;
+   const size_t total = bytes + tail_bytes;
+   if (tu_dw_twritten + tu_dw_tlen + total > TU_DW_TCAP) {
+      tu_dw_tlost++;
+      return;
+   }
+   if (tu_dw_tlen + total > TU_DW_TBUF)
+      tu_dw_trace_flush();
+   if (total > TU_DW_TBUF) {
+      tu_dw_tlost++;
+      return;
+   }
+   memcpy(tu_dw_tbuf + tu_dw_tlen, rec, bytes);
+   if (tail_bytes)
+      memcpy(tu_dw_tbuf + tu_dw_tlen + bytes, tail, tail_bytes);
+   tu_dw_tlen += total;
+}
+
+template <typename T>
+static void
+tu_dw_rec_init(T *rec, uint16_t type)
+{
+   memset(rec, 0, sizeof(*rec));
+   rec->head.type = type;
+   rec->head.bytes = sizeof(*rec);
+}
+
+uint32_t
+tu_dw_light_percent(void)
+{
+   static int percent = -1;
+   if (percent < 0) {
+      const char *v = getenv("TU_DW_LIGHT");
+      percent = v ? atoi(v) : 0;
+      if (percent < 0)
+         percent = 0;
+   }
+   return (uint32_t) percent;
+}
+
+uint32_t
+tu_dw_serial(struct tu_cmd_buffer *cmd)
+{
+   if (!cmd->dw_serial)
+      cmd->dw_serial = p_atomic_inc_return(&tu_dw_next_serial);
+   return cmd->dw_serial;
+}
+
+/* Shaders seen so far, by id; under tu_dw_trace_mtx. */
+static uint64_t tu_dw_seen[4096];
+static uint64_t
+tu_dw_shader_id(const struct tu_cmd_buffer *cmd, mesa_shader_stage stage)
+{
+   uint64_t id;
+   memcpy(&id, cmd->state.program.stage_blake3[stage], sizeof(id));
+   return id;
+}
+
+static void
+tu_dw_trace_shader(const struct tu_cmd_buffer *cmd, mesa_shader_stage stage, uint64_t id)
+{
+   const struct tu_shader *shader = cmd->state.shaders[stage];
+   const struct ir3_shader_variant *v = shader ? shader->variant : NULL;
+   if (!id || !v)
+      return;
+   unsigned at = (unsigned) (id % ARRAY_SIZE(tu_dw_seen));
+   for (unsigned probe = 0; probe < ARRAY_SIZE(tu_dw_seen); probe++, at = (at + 1) % ARRAY_SIZE(tu_dw_seen)) {
+      if (tu_dw_seen[at] == id)
+         return;
+      if (!tu_dw_seen[at])
+         break;
+   }
+   if (tu_dw_seen[at])
+      return;   /* the table is full: the shader goes unrecorded */
+   tu_dw_seen[at] = id;
+   struct tu_dw_trace_shader r;
+   tu_dw_rec_init(&r, TU_DW_REC_SHADER);
+   const struct ir3_info *i = &v->info;
+   r.id = id;
+   r.stage = (uint8_t) stage;
+   r.double_threadsize = i->double_threadsize;
+   r.subgroup_size = i->subgroup_size;
+   r.early_preamble = i->early_preamble;
+   r.max_reg = i->max_reg; r.max_half_reg = i->max_half_reg; r.max_waves = i->max_waves;
+   r.constlen = i->constlen; r.size = i->size;
+   r.sizedwords = i->sizedwords; r.instrs_count = i->instrs_count; r.preamble_instrs_count = i->preamble_instrs_count;
+   r.nops_count = i->nops_count; r.mov_count = i->mov_count; r.cov_count = i->cov_count; r.loops = i->loops;
+   r.stp_count = i->stp_count; r.ldp_count = i->ldp_count; r.ss = i->ss; r.sy = i->sy; r.sstall = i->sstall; r.systall = i->systall;
+   r.last_baryf = i->last_baryf; r.last_helper = i->last_helper;
+   memcpy(r.instrs_per_cat, i->instrs_per_cat, sizeof(r.instrs_per_cat));
+   const bool binary = (tu_dw_trace_flags() & TU_DW_TR_BINARIES) && v->bin;
+   r.bin_bytes = binary ? i->sizedwords * 4u : 0;
+   r.head.bytes += r.bin_bytes;
+   tu_dw_trace_put(&r, sizeof(r), binary ? v->bin : NULL, r.bin_bytes);
+}
+
+/* At a draw's tu6_draw_common: its record from the state it draws with, and with s, the sample counter's begin (as an occlusion query
+ * inside a render pass, tu_query_pool.cc emit_begin_occlusion_query). */
+void
+tu_dw_draw_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs, bool indexed, uint32_t count)
+{
+   cmd->dw_draw_samples = NULL;
+   const int flags = tu_dw_trace_flags();
+   if (!(flags & TU_DW_TR_DRAWS))
+      return;
+   const struct vk_dynamic_graphics_state *d = &cmd->vk.dynamic_graphics_state;
+   /* Blend state the bound pipeline holds as static comes from the pipeline (tu_graphics_pipeline::dw_cb), the rest from the
+    * command buffer; T61 read every draw's from the command buffer and found zeros. */
+   const struct tu_graphics_pipeline *gp = cmd->dw_pipeline && cmd->dw_pipeline->dw_has_cb ? cmd->dw_pipeline : NULL;
+   const auto cb = [&](unsigned bit) -> const struct vk_color_blend_state * {
+      return gp && BITSET_TEST(gp->base.static_state_mask, bit) ? &gp->dw_cb : &d->cb;
+   };
+   const struct vk_color_blend_state *cb_count = cb(MESA_VK_DYNAMIC_CB_ATTACHMENT_COUNT),
+                                     *cb_enables = cb(MESA_VK_DYNAMIC_CB_BLEND_ENABLES),
+                                     *cb_equations = cb(MESA_VK_DYNAMIC_CB_BLEND_EQUATIONS),
+                                     *cb_masks = cb(MESA_VK_DYNAMIC_CB_WRITE_MASKS),
+                                     *cb_writes = cb(MESA_VK_DYNAMIC_CB_COLOR_WRITE_ENABLES);
+   struct tu_dw_draw_pending p;
+   tu_dw_rec_init(&p.rec, TU_DW_REC_DRAW);
+   p.samples = NULL;
+   struct tu_dw_trace_draw *r = &p.rec;
+   r->serial = tu_dw_serial(cmd);
+   r->pass_no = cmd->dw_pass_no;
+   r->draw_no = (uint16_t) MIN2(cmd->dw_pass_draws, 0xffffu);
+   cmd->dw_pass_draws++;
+   r->vs_id = tu_dw_shader_id(cmd, MESA_SHADER_VERTEX);
+   r->fs_id = tu_dw_shader_id(cmd, MESA_SHADER_FRAGMENT);
+   r->count = count;
+   r->flags = (indexed ? 1 : 0) | (count ? 0 : 2);
+   r->att_count = cb_count->attachment_count;
+   for (unsigned a = 0; a < MIN2(cb_count->attachment_count, 8u); a++)
+      r->blend_mask |= cb_enables->attachments[a].blend_enable << a;
+   r->write_enables = cb_writes->color_write_enables;
+   if (cb_count->attachment_count) {
+      const struct vk_color_blend_attachment_state *e = &cb_equations->attachments[0];
+      r->write_mask = cb_masks->attachments[0].write_mask;
+      r->src_color = e->src_color_blend_factor; r->dst_color = e->dst_color_blend_factor; r->color_op = (uint8_t) e->color_blend_op;
+      r->src_alpha = e->src_alpha_blend_factor; r->dst_alpha = e->dst_alpha_blend_factor; r->alpha_op = (uint8_t) e->alpha_blend_op;
+   }
+   r->ds = (d->ds.depth.test_enable ? 1 : 0) | (d->ds.depth.write_enable ? 2 : 0) | (d->ds.stencil.test_enable ? 4 : 0) |
+           (d->ds.depth.bounds_test.enable ? 8 : 0);
+   r->samples_per_px = (uint8_t) d->ms.rasterization_samples;
+   if (d->vp.scissor_count) {
+      const VkRect2D *sc = &d->vp.scissors[0];
+      r->scissor[0] = (uint16_t) MIN2(MAX2(sc->offset.x, 0), 0xffff); r->scissor[1] = (uint16_t) MIN2(MAX2(sc->offset.y, 0), 0xffff);
+      r->scissor[2] = (uint16_t) MIN2(sc->extent.width, 0xffffu); r->scissor[3] = (uint16_t) MIN2(sc->extent.height, 0xffffu);
+   }
+   r->samples = ~0ull;
+   simple_mtx_lock(&tu_dw_trace_mtx);
+   tu_dw_trace_shader(cmd, MESA_SHADER_VERTEX, r->vs_id);
+   tu_dw_trace_shader(cmd, MESA_SHADER_FRAGMENT, r->fs_id);
+   simple_mtx_unlock(&tu_dw_trace_mtx);
+
+   struct tu_cs_memory memory;
+   if ((flags & TU_DW_TR_SAMPLES) && cmd->state.pass && cmd->device->physical_device->info->props.has_event_write_sample_count &&
+       tu_dw_alloc(cmd, 8, &memory)) {
+      p.samples = (const volatile uint64_t *) memory.map;
+      cmd->dw_draw_samples = (uint64_t *) memory.map;
+      tu_cs_emit_regs(cs, A6XX_RB_SAMPLE_COUNTER_CNTL(.copy = true));
+      tu_cs_emit_pkt7(cs, CP_EVENT_WRITE7, 3);
+      tu_cs_emit(cs, CP_EVENT_WRITE7_0(.event = ZPASS_DONE, .write_sample_count = true).value);
+      tu_cs_emit_qw(cs, memory.iova);
+      cmd->state.rp.has_zpass_done_sample_count_write_in_rp = true;
+      /* the end event finds the slot by its address */
+      p.rec.samples = memory.iova;
+   }
+   util_dynarray_append(&cmd->dw_draws, p);
+}
+
+/* After the draw packet: the sample counter's end, which adds this tile's samples to the slot's result (emit_end_occlusion_query). */
+void
+tu_dw_draw_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   if (!cmd->dw_draw_samples)
+      return;
+   struct tu_dw_draw_pending *p = util_dynarray_top_ptr(&cmd->dw_draws, struct tu_dw_draw_pending);
+   tu_cs_emit_regs(cs, A6XX_RB_SAMPLE_COUNTER_CNTL(.copy = true));
+   tu_cs_emit_pkt7(cs, CP_EVENT_WRITE7, 3);
+   tu_cs_emit(cs, CP_EVENT_WRITE7_0(.event = ZPASS_DONE, .write_sample_count = true, .sample_count_end_offset = true,
+                                    .write_accum_sample_count_diff = true).value);
+   tu_cs_emit_qw(cs, p->rec.samples);
+   tu_cs_emit_wfi(cs);
+   if (cmd->device->physical_device->info->chip >= 8) {
+      tu_cs_emit_pkt7(cs, CP_BARRIER, 1);
+      tu_cs_emit(cs, 1);
+   }
+   cmd->dw_draw_samples = NULL;
+}
+
+/* T58: the GPU writes these, so they come from the sub stream's GPU-writable memory; command memory is mapped GPU read-only
+ * (tu_cs_add_bo), and T55 and T57 hung writing their stamps there. */
+static bool
+tu_dw_alloc(struct tu_cmd_buffer *cmd, uint32_t dwords, struct tu_cs_memory *memory)
+{
+   tu_cs_set_writeable(&cmd->sub_cs, true);
+   const VkResult result = tu_cs_alloc(&cmd->sub_cs, 1, dwords, memory);
+   tu_cs_set_writeable(&cmd->sub_cs, false);
+   if (result != VK_SUCCESS)
+      return false;
+   memset(memory->map, 0, dwords * 4);
+   return true;
+}
+
+static void
+tu_dw_timestamp(struct tu_cmd_buffer *cmd, struct tu_cs *cs, uint64_t iova, bool end)
+{
+   /* T57: the always-on counter copied to memory, as the autotune samples it (tu_autotune.cc emit_metric_timestamp); an end stamp
+    * waits for the GPU to go idle first, so it lands after the work. T55's CP_EVENT_WRITE7 RB_DONE_TS with the always-on source hung
+    * the A810 on the render server's first frame. */
+   if (end)
+      tu_cs_emit_wfi(cs);
+   tu_cs_emit_pkt7(cs, CP_REG_TO_MEM, 3);
+   tu_cs_emit(cs, CP_REG_TO_MEM_0_REG(TU_CALLX(cmd->device, __CP_ALWAYS_ON_COUNTER)({}).reg) | CP_REG_TO_MEM_0_CNT(2) |
+                     CP_REG_TO_MEM_0_64B);
+   tu_cs_emit_qw(cs, iova);
+}
+
+unsigned
+tu_dw_time_begin(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned kind)
+{
+   /* Only where TU_DW_TIME is set (the asteroids Metal plugin sets it in the render server with asteroids-tu-time=<value>). */
+   const int mode = tu_dw_mode();
+   if (!mode || (mode != 2 && kind != TU_DW_PASS_GMEM && kind != TU_DW_PASS_SYSMEM))
+      return ~0u;
+   if (cmd->dw_slot_count >= TU_DW_MAX_SLOTS) {
+      p_atomic_inc(&tu_dw_dropped);
+      return ~0u;
+   }
+   struct tu_cs_memory memory;
+   if (!tu_dw_alloc(cmd, 4, &memory))
+      return ~0u;
+   const unsigned slot = cmd->dw_slot_count++;
+   cmd->dw_slots[slot] = {};
+   cmd->dw_slots[slot].map = memory.map;
+   cmd->dw_slots[slot].iova = memory.iova;
+   cmd->dw_slots[slot].kind = (uint8_t) kind;
+   tu_dw_timestamp(cmd, cs, memory.iova, false);
+   return slot;
+}
+
+void
+tu_dw_frag_entry(uint64_t area_px, uint32_t draws, uint64_t samples, bool has_samples, bool sysmem, uint32_t serial,
+                 uint16_t pass_no)
+{
+   if (!tu_dw_mode())
+      return;
+   if (tu_dw_trace_flags() && serial) {
+      struct tu_dw_trace_frag r;
+      tu_dw_rec_init(&r, TU_DW_REC_FRAG);
+      r.serial = serial; r.pass_no = pass_no; r.sysmem = sysmem; r.has_samples = has_samples;
+      r.draws = draws; r.area_px = (uint32_t) MIN2(area_px, 0xffffffffull); r.samples = samples;
+      simple_mtx_lock(&tu_dw_trace_mtx);
+      tu_dw_trace_put(&r, sizeof(r));
+      simple_mtx_unlock(&tu_dw_trace_mtx);
+   }
+   const unsigned large = area_px >= TU_DW_LARGE_PX;
+   simple_mtx_lock(&tu_dw_mtx);
+   if (!has_samples) {
+      tu_dw_frag_nosamples++;
+   } else {
+      tu_dw_frag_n[large]++;
+      tu_dw_frag_draws[large] += draws;
+      tu_dw_frag_samples[large] += samples;
+      tu_dw_frag_area[large] += area_px;
+      tu_dw_frag_sysmem[large] += sysmem;
+      tu_dw_frag_max_draws = MAX2(tu_dw_frag_max_draws, draws);
+   }
+   simple_mtx_unlock(&tu_dw_mtx);
+}
+
+/* T59, TU_DW_TIME=tiles: at the first subpass's begin, a stage record for the pass, and in draw_cs after its loads and clears (GMEM
+ * only) the loads stamp, which every tile runs. */
+void
+tu_dw_rp_loads(struct tu_cmd_buffer *cmd)
+{
+   cmd->dw_rp_map = NULL;
+   if (tu_dw_mode() != 3)
+      return;
+   struct tu_cs_memory memory;
+   if (!tu_dw_alloc(cmd, TU_DW_RP_WORDS * 2, &memory))
+      return;
+   cmd->dw_rp_map = (uint64_t *) memory.map;
+   cmd->dw_rp_iova = memory.iova;
+   tu_cond_exec_start(&cmd->draw_cs, CP_COND_EXEC_0_RENDER_MODE_GMEM);
+   tu_dw_timestamp(cmd, &cmd->draw_cs, cmd->dw_rp_iova + TU_DW_RP_LOADS * 8, true);
+   tu_cond_exec_end(&cmd->draw_cs);
+}
+
+/* A stage stamp into the pass's record; the tile start does not wait for idle (the previous tile ended with one). */
+void
+tu_dw_rp_stamp(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned which)
+{
+   if (cmd->dw_rp_map)
+      tu_dw_timestamp(cmd, cs, cmd->dw_rp_iova + which * 8, which != TU_DW_RP_TILE);
+}
+
+/* After a tile's stores: its stores stamp, then the GPU adds the tile's loads, draws and stores into the record's sums
+ * (dst = srcA + srcB - srcC, as the occlusion queries accumulate). */
+void
+tu_dw_rp_tile_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs)
+{
+   if (!cmd->dw_rp_map)
+      return;
+   tu_dw_timestamp(cmd, cs, cmd->dw_rp_iova + TU_DW_RP_STORES * 8, true);
+   tu_cs_emit_pkt7(cs, CP_WAIT_MEM_WRITES, 0);
+   tu_cs_emit_pkt7(cs, CP_WAIT_FOR_ME, 0);
+   static const unsigned sums[3][3] = {
+      {TU_DW_RP_SUM_LOADS, TU_DW_RP_LOADS, TU_DW_RP_TILE},
+      {TU_DW_RP_SUM_DRAWS, TU_DW_RP_DRAWS, TU_DW_RP_LOADS},
+      {TU_DW_RP_SUM_STORES, TU_DW_RP_STORES, TU_DW_RP_DRAWS},
+   };
+   for (unsigned i = 0; i < 3; i++) {
+      tu_cs_emit_pkt7(cs, CP_MEM_TO_MEM, 9);
+      tu_cs_emit(cs, CP_MEM_TO_MEM_0_DOUBLE | CP_MEM_TO_MEM_0_NEG_C);
+      tu_cs_emit_qw(cs, cmd->dw_rp_iova + sums[i][0] * 8);
+      tu_cs_emit_qw(cs, cmd->dw_rp_iova + sums[i][0] * 8);
+      tu_cs_emit_qw(cs, cmd->dw_rp_iova + sums[i][1] * 8);
+      tu_cs_emit_qw(cs, cmd->dw_rp_iova + sums[i][2] * 8);
+   }
+   tu_cs_emit_pkt7(cs, CP_WAIT_MEM_WRITES, 0);
+   cmd->dw_rp_tiles++;
+}
+
+void
+tu_dw_time_end(struct tu_cmd_buffer *cmd, struct tu_cs *cs, unsigned slot)
+{
+   if (slot >= cmd->dw_slot_count)
+      return;
+   tu_dw_timestamp(cmd, cs, cmd->dw_slots[slot].iova + 8, true);
+}
+
+/* TU_DW_TRACE: the recording's slots and draws as records, once the GPU is done with them. */
+static void
+tu_dw_trace_collect(struct tu_cmd_buffer *cmd)
+{
+   const int flags = tu_dw_trace_flags();
+   if (!flags)
+      return;
+   simple_mtx_lock(&tu_dw_trace_mtx);
+   for (unsigned i = 0; i < cmd->dw_slot_count; i++) {
+      const struct tu_dw_slot *sl = &cmd->dw_slots[i];
+      const volatile uint32_t *map = sl->map;
+      struct tu_dw_trace_pass r;
+      tu_dw_rec_init(&r, TU_DW_REC_PASS);
+      r.serial = cmd->dw_serial; r.pass_no = sl->pass_no; r.kind = sl->kind;
+      r.start = (uint64_t) map[1] << 32 | map[0]; r.end = (uint64_t) map[3] << 32 | map[2];
+      r.area_px = sl->area_px; r.width = sl->width; r.height = sl->height;
+      r.tiles = (uint16_t) MIN2(sl->tiles, 0xffffu); r.tile_w = sl->tile_w; r.tile_h = sl->tile_h;
+      r.loads = sl->loads; r.stores = sl->stores; r.subpasses = sl->subpasses; r.attachments = sl->attachments;
+      r.draws = sl->draws;
+      r.flags = (sl->binning ? 1 : 0) | (sl->light ? 4 : 0);
+      if (sl->rp_map) {
+         const volatile uint64_t *rp = sl->rp_map;
+         r.flags |= 2;
+         r.st_begin = rp[TU_DW_RP_BEGIN]; r.st_last = rp[TU_DW_RP_STORES];
+         r.sum_loads = rp[TU_DW_RP_SUM_LOADS]; r.sum_draws = rp[TU_DW_RP_SUM_DRAWS]; r.sum_stores = rp[TU_DW_RP_SUM_STORES];
+      }
+      for (unsigned a = 0; a < 4; a++) {
+         r.att[a].format = sl->att[a].format; r.att[a].samples = sl->att[a].samples; r.att[a].flags = sl->att[a].flags;
+      }
+      if (sl->kind == TU_DW_PASS_GMEM || sl->kind == TU_DW_PASS_SYSMEM || (flags & TU_DW_TR_ALL))
+         tu_dw_trace_put(&r, sizeof(r));
+   }
+   util_dynarray_foreach (&cmd->dw_draws, struct tu_dw_draw_pending, p) {
+      p->rec.serial = cmd->dw_serial;
+      p->rec.samples = p->samples ? p->samples[1] : ~0ull;
+      tu_dw_trace_put(&p->rec, sizeof(p->rec));
+   }
+   const uint64_t now = os_time_get_nano();
+   if (now - tu_dw_tflushed_ns >= 1000000000ull) {
+      if (tu_dw_tlost) {
+         struct PACKED { struct tu_dw_rec_head head; uint32_t lost; } note = {{TU_DW_REC_NOTE, 0, 8}, tu_dw_tlost};
+         tu_dw_tlost = 0;
+         tu_dw_trace_put(&note, sizeof(note));
+      }
+      tu_dw_trace_flush();
+      tu_dw_tflushed_ns = now;
+   }
+   simple_mtx_unlock(&tu_dw_trace_mtx);
+}
+
+void
+tu_dw_time_collect(struct tu_cmd_buffer *cmd)
+{
+   tu_dw_trace_collect(cmd);
+   util_dynarray_clear(&cmd->dw_draws);
+   cmd->dw_draw_samples = NULL;
+   cmd->dw_pipeline = NULL;
+   cmd->dw_serial = 0;
+   cmd->dw_pass_no = 0;
+   cmd->dw_pass_draws = 0;
+   cmd->dw_rp_map = NULL;
+   cmd->dw_rp_tiles = 0;
+   if (!cmd->dw_slot_count)
+      return;
+   simple_mtx_lock(&tu_dw_mtx);
+   for (unsigned i = 0; i < cmd->dw_slot_count; i++) {
+      const volatile uint32_t *map = cmd->dw_slots[i].map;
+      const uint64_t start = (uint64_t) map[1] << 32 | map[0], end = (uint64_t) map[3] << 32 | map[2];
+      if (!start || end <= start || end - start > 19200000ull) {   /* never ran, or over a second: not counted */
+         tu_dw_unrun++;
+         continue;
+      }
+      tu_dw_ticks[cmd->dw_slots[i].kind] += end - start;
+      tu_dw_counts[cmd->dw_slots[i].kind]++;
+      const struct tu_dw_slot *sl = &cmd->dw_slots[i];
+      if (sl->kind == TU_DW_PASS_GMEM || sl->kind == TU_DW_PASS_SYSMEM) {
+         const unsigned large = sl->area_px >= TU_DW_LARGE_PX;
+         tu_dw_size_passes[large]++;
+         tu_dw_size_ticks[large] += end - start;
+         tu_dw_size_area[large] += sl->area_px;
+      }
+      if (sl->rp_map && sl->tiles) {
+         const volatile uint64_t *rp = sl->rp_map;
+         const uint64_t begin = rp[TU_DW_RP_BEGIN], last = rp[TU_DW_RP_STORES];
+         const uint64_t loads = rp[TU_DW_RP_SUM_LOADS], draws = rp[TU_DW_RP_SUM_DRAWS], stores = rp[TU_DW_RP_SUM_STORES];
+         if (begin < start || last < begin || end < last || loads + draws + stores > last - begin) {
+            tu_dw_stage_rejected++;   /* a stamp missing (no loads stamp in this pass's draw_cs) or out of order */
+            continue;
+         }
+         tu_dw_stage_ticks[0] += begin - start;
+         tu_dw_stage_ticks[1] += loads;
+         tu_dw_stage_ticks[2] += draws;
+         tu_dw_stage_ticks[3] += stores;
+         tu_dw_stage_ticks[4] += end - last;
+         tu_dw_stage_ticks[5] += (last - begin) - (loads + draws + stores);
+         tu_dw_stage_passes++;
+         tu_dw_stage_tiles += sl->tiles;
+         tu_dw_stage_max_tiles = MAX2(tu_dw_stage_max_tiles, sl->tiles);
+         tu_dw_stage_binning += sl->binning;
+         tu_dw_stage_loads += sl->loads;
+         tu_dw_stage_stores += sl->stores;
+         tu_dw_stage_multi += sl->subpasses > 1;
+         tu_dw_stage_tile_px += (uint64_t) sl->tile_px * sl->tiles;
+         tu_dw_stage_area_px += sl->area_px;
+      }
+   }
+   tu_dw_buffers++;
+   cmd->dw_slot_count = 0;
+   const uint64_t now = os_time_get_nano();
+   if (tu_dw_send_times && now - tu_dw_last_send_ns >= 1000000000ull) {
+      /* [0..5] microseconds per kind (19.2 MHz always-on ticks), [6..11] brackets per kind, [12] command buffers, [13] brackets that
+       * never ran, [14] brackets dropped (over TU_DW_MAX_SLOTS) */
+      uint32_t words[15];
+      for (unsigned k = 0; k < TU_DW_KINDS; k++) {
+         words[k] = (uint32_t) (tu_dw_ticks[k] * 10 / 192);
+         words[6 + k] = tu_dw_counts[k];
+         tu_dw_ticks[k] = 0;
+         tu_dw_counts[k] = 0;
+      }
+      words[12] = tu_dw_buffers; words[13] = tu_dw_unrun; words[14] = p_atomic_xchg(&tu_dw_dropped, 0);
+      tu_dw_buffers = tu_dw_unrun = 0;
+      tu_dw_last_send_ns = now;
+      tu_dw_send_times(0x54494d45u, words, 15);   /* 'TIME' */
+      /* [0..2] large passes timed, microseconds, render area in kilopixels; [3..5] the same for small passes; [6..9] large passes
+       * the autotune measured: entries, draws, samples passed in kilosamples, render area in kilopixels; [10..13] the same for
+       * small; [14] large entries rendered in system memory, [15] most draws in a pass */
+      uint32_t f[16];
+      for (unsigned k = 0; k < 2; k++) {
+         f[k * 3] = tu_dw_size_passes[1 - k];
+         f[k * 3 + 1] = (uint32_t) (tu_dw_size_ticks[1 - k] * 10 / 192);
+         f[k * 3 + 2] = (uint32_t) (tu_dw_size_area[1 - k] >> 10);
+         f[6 + k * 4] = tu_dw_frag_n[1 - k];
+         f[7 + k * 4] = tu_dw_frag_draws[1 - k];
+         f[8 + k * 4] = (uint32_t) (tu_dw_frag_samples[1 - k] >> 10);
+         f[9 + k * 4] = (uint32_t) (tu_dw_frag_area[1 - k] >> 10);
+      }
+      f[14] = tu_dw_frag_sysmem[1];
+      f[15] = tu_dw_frag_max_draws;
+      memset(tu_dw_size_ticks, 0, sizeof(tu_dw_size_ticks)); memset(tu_dw_size_area, 0, sizeof(tu_dw_size_area));
+      memset(tu_dw_size_passes, 0, sizeof(tu_dw_size_passes)); memset(tu_dw_frag_samples, 0, sizeof(tu_dw_frag_samples));
+      memset(tu_dw_frag_area, 0, sizeof(tu_dw_frag_area)); memset(tu_dw_frag_n, 0, sizeof(tu_dw_frag_n));
