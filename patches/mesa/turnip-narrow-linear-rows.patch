+/* A linear image whose rows step at less than 64 bytes (narrow_linear_rows): the texture descriptor
+ * samples it, but neither the 2D engine nor a render target steps rows so. Transfers that touch it
+ * are skipped and counted (tu_narrow_rows_skipped).
+ */
+static inline bool
+tu_image_narrow_rows(const struct tu_image *image)
+{
+   return image->layout[0].tile_mode == TILE6_LINEAR && image->layout[0].pitchalign < 6;
+}
