+   if (sysmem) {
+      /* bit 0 TU_DEBUG(SYSMEM), 1 attachments don't fit, 2 empty render area, 3 tessellation, 4 attachment feedback loop,
+       * 5 too many tiles without HW binning, 6 autotune, 7 anything else (a non-framebuffer-space barrier) */
+      const char *why = cmd_buffer->state.rp.gmem_disable_reason ? cmd_buffer->state.rp.gmem_disable_reason : "";
