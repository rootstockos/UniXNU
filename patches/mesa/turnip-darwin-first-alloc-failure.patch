+/* asteroids: the first failed BO allocation or map of this process as one line of SetMetadata text without an object: the driver copies any
+ * such text to its report line (NativeAdrenoPublish.cpp runCore) before refusing the unknown tag, and the board prints that line when it
+ * changes, every 2 s, so a later line would hide this one. "AF <step> s<KiB> f<flags> k<status> u<MiB in use> h<largest hole MiB>
+ * c<cached MiB> <process>"; steps: r retired BOs (the device was lost), v GPU range, a BoAlloc, m BoMap, p BoCpuMap, i IOConnectMapMemory64 (f is
+ * the mapped length), H a host import's GPU range (a refused import is the bridge's ordinary fallback, so only the range is noted). */
+static void
+darwin_note_failure(struct tu_device *dev, char step, uint64_t size, uint32_t flags, uint32_t status)
+{
+   static uint32_t failures;
+   if (p_atomic_inc_return(&failures) != 1)
+      return;
+   struct darwin_retire_state *retire = (struct darwin_retire_state *)dev->darwin_retire;
+   uint64_t used = 0, largest = 0;
+   mtx_lock(&dev->vma_mutex);
+   used = retire->va.used;
+   for (struct rb_node *x = retire->va.size.root; x; x = x->right)   /* the right subtree holds the larger holes */
+      largest = rb_node_data(struct darwin_va_hole, x, by_size)->size;
+   mtx_unlock(&dev->vma_mutex);
+   NativeAdrenoAbiMetadata req = {};
+   req.reserved = 0x4641494cu;   /* 'FAIL': no handler, so only the report line keeps it */
+   int len = snprintf(req.text, sizeof(req.text), "AF %c s%llu f%x k%x u%llu h%llu c%llu %.12s", step, (unsigned long long)(size >> 10),
+                      flags, status, (unsigned long long)(used >> 20), (unsigned long long)(largest >> 20),
+                      (unsigned long long)(retire->cache_bytes >> 20), getprogname());
+   req.bytes = (uint32_t)MIN2(MAX2(len, 0), (int)sizeof(req.text));
+   (void)dw_call(NativeAdrenoMethodSetMetadata, &req, sizeof(req), NULL, 0);
+}
+
